MCPR_TOKEN=your-mcp-router-token-here

# Optional overrides (defaults shown):
# HTTP_PORT=3456
# HTTP_HOST=127.0.0.1
# POLL_INTERVAL_MS=15000
# DISCOVER_LIMIT=10

# Tool allow/deny lists (comma-separated regex patterns on tool names).
# ALLOW acts as a scope (if non-empty, only matching tools are exposed).
# DENY always excludes. Both can be set together.
# Examples:
#   ALLOW_TOOLS=^github_.*,^slack_.*
#   DENY_TOOLS=.*_delete_.*,^admin_.*
# ALLOW_TOOLS=
# DENY_TOOLS=

# Remote bind (DANGEROUS — no auth on execute_tool). Leave unset unless you
# understand the risk and have set AUTH_TOKEN.
# ALLOW_REMOTE=0
